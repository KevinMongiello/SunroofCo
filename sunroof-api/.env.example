# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for running the API outside Docker.
# The Docker demo supplies its own disposable local database.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

PORT=3000
CORS_ORIGINS=http://localhost:5173
ANTHROPIC_API_KEY=replace-with-your-api-key
# Render Docker startup sets this automatically. For local AI calls, use a public URL.
# SUNROOF_MCP_URL=https://your-api.onrender.com/mcp
MAX_AI_TOKENS=5000
